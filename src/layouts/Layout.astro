---
// Import global styles
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const defaultDescription =
  'Prvi certificirani B.A.S.I. Pilates studio u Hrvatskoj od 2007. Pilates mašine, Power Vinyasa Yoga, individualni i grupni satovi.';
const metaDescription = description || defaultDescription;

// Get current path for active navigation
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/images/Flexio_logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    <meta
      name="keywords"
      content="pilates, yoga, B.A.S.I. pilates, pilates zagreb, yoga zagreb, pilates mašine, reformer, cadillac, vinyasa yoga, flexio"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://flexio.com.hr/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://flexio.com.hr/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={metaDescription} />

    <title>{title}</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans antialiased">
    <style>
      html {
        scroll-behavior: smooth;
      }
      .font-display {
        font-family: 'Playfair Display', serif;
      }
    </style>

    <!-- Navigation -->
    <nav
      class="fixed top-0 w-full bg-white/95 backdrop-blur-md z-50 border-b border-gray-100 shadow-sm"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16 md:h-20">
          <!-- Logo -->
          <div class="flex-shrink-0">
            <a href="/" class="block group">
              <img
                src="/images/Flexio_logo.png"
                alt="Flexio Pilates Yoga Aerobic"
                class="h-10 md:h-12 w-auto transition-transform group-hover:scale-105"
              />
            </a>
          </div>

          <!-- Desktop Navigation -->
          <div class="hidden md:block">
            <div class="ml-10 flex items-baseline space-x-6 lg:space-x-8">
              <a
                href="/"
                class={`px-3 py-2 text-sm font-medium uppercase tracking-wide transition-colors ${
                  currentPath === '/'
                    ? 'text-flexio'
                    : 'text-gray-600 hover:text-flexio'
                }`}
                >Naslovnica</a
              >
              <a
                href="/o-nama"
                class={`px-3 py-2 text-sm font-medium uppercase tracking-wide transition-colors ${
                  currentPath === '/o-nama' || currentPath === '/o-nama/'
                    ? 'text-flexio'
                    : 'text-gray-600 hover:text-flexio'
                }`}
                >O nama</a
              >
              <a
                href="/program"
                class={`px-3 py-2 text-sm font-medium uppercase tracking-wide transition-colors ${
                  currentPath === '/program' || currentPath === '/program/'
                    ? 'text-flexio'
                    : 'text-gray-600 hover:text-flexio'
                }`}
                >Program</a
              >
              <a
                href="/dogadanja"
                class={`px-3 py-2 text-sm font-medium uppercase tracking-wide transition-colors ${
                  currentPath === '/dogadanja' || currentPath === '/dogadanja/'
                    ? 'text-flexio'
                    : 'text-gray-600 hover:text-flexio'
                }`}
                >Događanja</a
              >
              <a
                href="/galerija"
                class={`px-3 py-2 text-sm font-medium uppercase tracking-wide transition-colors ${
                  currentPath === '/galerija' || currentPath === '/galerija/'
                    ? 'text-flexio'
                    : 'text-gray-600 hover:text-flexio'
                }`}
                >Galerija</a
              >
              <a
                href="/kontakt"
                class={`px-3 py-2 text-sm font-medium uppercase tracking-wide transition-colors ${
                  currentPath === '/kontakt' || currentPath === '/kontakt/'
                    ? 'text-flexio'
                    : 'text-gray-600 hover:text-flexio'
                }`}
                >Kontakt</a
              >
            </div>
          </div>

          <!-- CTA Button - Desktop -->
          <div class="hidden md:block">
            <a
              href="/kontakt"
              class="bg-flexio text-white px-6 py-2.5 rounded-full text-sm font-medium hover:bg-purple-700 transition-all shadow-md hover:shadow-lg"
            >
              Rezerviraj termin
            </a>
          </div>

          <!-- Mobile menu button -->
          <div class="md:hidden">
            <button
              type="button"
              id="mobile-menu-button"
              class="text-gray-600 hover:text-gray-900 focus:outline-none focus:text-gray-900"
              aria-label="Toggle menu"
            >
              <svg
                id="menu-icon"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
              <svg
                id="close-icon"
                class="h-6 w-6 hidden"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        class="md:hidden hidden bg-white border-t border-gray-100"
      >
        <div class="px-4 pt-2 pb-4 space-y-1">
          <a
            href="/"
            class={`block px-3 py-3 rounded-md text-base font-medium transition-colors ${
              currentPath === '/'
                ? 'bg-purple-50 text-flexio'
                : 'text-gray-600 hover:bg-purple-50 hover:text-flexio'
            }`}
            >Naslovnica</a
          >
          <a
            href="/o-nama"
            class={`block px-3 py-3 rounded-md text-base font-medium transition-colors ${
              currentPath === '/o-nama' || currentPath === '/o-nama/'
                ? 'bg-purple-50 text-flexio'
                : 'text-gray-600 hover:bg-purple-50 hover:text-flexio'
            }`}
            >O nama</a
          >
          <a
            href="/program"
            class={`block px-3 py-3 rounded-md text-base font-medium transition-colors ${
              currentPath === '/program' || currentPath === '/program/'
                ? 'bg-purple-50 text-flexio'
                : 'text-gray-600 hover:bg-purple-50 hover:text-flexio'
            }`}
            >Program</a
          >
          <a
            href="/dogadanja"
            class={`block px-3 py-3 rounded-md text-base font-medium transition-colors ${
              currentPath === '/dogadanja' || currentPath === '/dogadanja/'
                ? 'bg-purple-50 text-flexio'
                : 'text-gray-600 hover:bg-purple-50 hover:text-flexio'
            }`}
            >Događanja</a
          >
          <a
            href="/galerija"
            class={`block px-3 py-3 rounded-md text-base font-medium transition-colors ${
              currentPath === '/galerija' || currentPath === '/galerija/'
                ? 'bg-purple-50 text-flexio'
                : 'text-gray-600 hover:bg-purple-50 hover:text-flexio'
            }`}
            >Galerija</a
          >
          <a
            href="/kontakt"
            class={`block px-3 py-3 rounded-md text-base font-medium transition-colors ${
              currentPath === '/kontakt' || currentPath === '/kontakt/'
                ? 'bg-purple-50 text-flexio'
                : 'text-gray-600 hover:bg-purple-50 hover:text-flexio'
            }`}
            >Kontakt</a
          >
          <a
            href="/kontakt"
            class="block mt-4 text-center bg-flexio text-white px-6 py-3 rounded-full text-base font-medium hover:bg-purple-700 transition-colors"
          >
            Rezerviraj termin
          </a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="pt-16 md:pt-20">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
          <!-- Brand -->
          <div class="sm:col-span-2 lg:col-span-1">
            <a href="/" class="inline-block mb-4">
              <img
                src="/images/Flexio_logo.png"
                alt="Flexio Pilates Yoga Aerobic"
                class="h-12 w-auto brightness-150"
              />
            </a>
            <p class="text-gray-400 leading-relaxed mb-4">
              Prvi certificirani B.A.S.I. Pilates studio u Hrvatskoj od 2007.
              godine.
            </p>
            <p class="text-sm text-gray-500">Zagreb, Hrvatska</p>
          </div>

          <!-- Quick Links -->
          <div>
            <h4 class="text-lg font-semibold mb-4">Navigacija</h4>
            <ul class="space-y-3 text-gray-400">
              <li>
                <a
                  href="/"
                  class="hover:text-white transition-colors inline-flex items-center"
                >
                  <span class="mr-2">→</span> Naslovnica
                </a>
              </li>
              <li>
                <a
                  href="/o-nama"
                  class="hover:text-white transition-colors inline-flex items-center"
                >
                  <span class="mr-2">→</span> O nama
                </a>
              </li>
              <li>
                <a
                  href="/program"
                  class="hover:text-white transition-colors inline-flex items-center"
                >
                  <span class="mr-2">→</span> Program
                </a>
              </li>
              <li>
                <a
                  href="/dogadanja"
                  class="hover:text-white transition-colors inline-flex items-center"
                >
                  <span class="mr-2">→</span> Događanja
                </a>
              </li>
              <li>
                <a
                  href="/galerija"
                  class="hover:text-white transition-colors inline-flex items-center"
                >
                  <span class="mr-2">→</span> Galerija
                </a>
              </li>
              <li>
                <a
                  href="/kontakt"
                  class="hover:text-white transition-colors inline-flex items-center"
                >
                  <span class="mr-2">→</span> Kontakt
                </a>
              </li>
            </ul>
          </div>

          <!-- Services -->
          <div>
            <h4 class="text-lg font-semibold mb-4">Program</h4>
            <ul class="space-y-3 text-gray-400">
              <li>
                <a
                  href="/program"
                  class="hover:text-white transition-colors inline-flex items-center"
                >
                  <span class="mr-2">→</span> Pilates mašine
                </a>
              </li>
              <li>
                <a
                  href="/program"
                  class="hover:text-white transition-colors inline-flex items-center"
                >
                  <span class="mr-2">→</span> Power Vinyasa Yoga
                </a>
              </li>
              <li>
                <a
                  href="/program"
                  class="hover:text-white transition-colors inline-flex items-center"
                >
                  <span class="mr-2">→</span> Individualni satovi
                </a>
              </li>
              <li>
                <a
                  href="/program"
                  class="hover:text-white transition-colors inline-flex items-center"
                >
                  <span class="mr-2">→</span> Grupni satovi
                </a>
              </li>
            </ul>
          </div>

          <!-- Contact -->
          <div>
            <h4 class="text-lg font-semibold mb-4">Kontakt</h4>
            <ul class="space-y-3 text-gray-400">
              <li>
                <a
                  href="mailto:petra@flexio.com.hr"
                  class="hover:text-white transition-colors"
                >
                  petra@flexio.com.hr
                </a>
              </li>
              <li>
                <a
                  href="tel:+385992157495"
                  class="hover:text-white transition-colors"
                >
                  099 2157 495
                </a>
              </li>
              <li class="text-gray-400">
                Luke Kaliterne 7<br />
                10000 Zagreb
              </li>
              <li class="pt-2">
                <a
                  href="https://www.facebook.com/flexio.pilates"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-gray-400 hover:text-white transition-colors"
                >
                  <svg
                    class="w-5 h-5 mr-2"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                    ></path>
                  </svg>
                  Facebook
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Bottom Bar -->
        <div
          class="border-t border-gray-800 pt-8 flex flex-col sm:flex-row justify-between items-center text-gray-400 text-sm"
        >
          <p class="mb-4 sm:mb-0">
            &copy; 2008 - {new Date().getFullYear()} Flexio Pilates Yoga Studio.
            Sva prava pridržana.
          </p>
          <p class="text-gray-500">B.A.S.I. Pilates certificirano od 2007.</p>
        </div>
      </div>
    </footer>

    <!-- Mobile Menu Script -->
    <script>
      // Mobile menu toggle
      const mobileMenuButton = document.getElementById('mobile-menu-button');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');

      if (mobileMenuButton && mobileMenu) {
        mobileMenuButton.addEventListener('click', () => {
          const isHidden = mobileMenu.classList.contains('hidden');

          if (isHidden) {
            mobileMenu.classList.remove('hidden');
            menuIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
          } else {
            mobileMenu.classList.add('hidden');
            menuIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
          }
        });

        // Close mobile menu when clicking on a link
        const mobileLinks = mobileMenu.querySelectorAll('a');
        mobileLinks.forEach((link) => {
          link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
            menuIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
          });
        });
      }
    </script>
  </body>
</html>

