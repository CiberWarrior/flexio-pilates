---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Flexio Pilates & Yoga Studio Zagreb | B.A.S.I. Pilates od 2007"
  description="Prvi certificirani B.A.S.I. Pilates studio u Hrvatskoj od 2007. Pilates mašine, Power Vinyasa Yoga, individualni i grupni satovi. Rezervirajte svoj termin danas!"
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-purple-50 via-pink-50 to-purple-100 py-20 md:py-32">
    <div class="absolute inset-0 overflow-hidden opacity-10">
      <div class="absolute top-20 left-10 w-72 h-72 bg-flexio rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-purple-600 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Badge -->
      <div class="inline-block mb-6">
        <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-white/80 backdrop-blur-sm text-flexio border border-purple-200 shadow-lg">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          Prvi certificirani B.A.S.I. Pilates studio u Hrvatskoj
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-gray-900 mb-6 font-display leading-tight">
        Otvorite vrata do zdravijeg tijela<br />
        <span class="text-flexio">i smirenijeg uma</span>
      </h1>

      <p class="text-xl sm:text-2xl text-gray-700 mb-8 max-w-3xl mx-auto leading-relaxed">
        Započnite svoje putovanje kroz pilates i yoga i otkrijte snagu svakog pokreta
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a
          href="/kontakt"
          class="bg-flexio text-white px-8 py-4 rounded-full text-lg font-medium hover:bg-purple-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-1"
        >
          Rezerviraj termin
        </a>
        <a
          href="/program"
          class="border-2 border-flexio text-flexio bg-white/80 backdrop-blur-sm px-8 py-4 rounded-full text-lg font-medium hover:bg-flexio hover:text-white transition-all shadow-md hover:shadow-lg"
        >
          Pogledaj program
        </a>
      </div>

      <!-- Quick Info -->
      <div class="flex flex-wrap justify-center gap-8 text-sm text-gray-600">
        <div class="flex items-center">
          <svg class="w-5 h-5 text-flexio mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
          Male grupe 8-10 osoba
        </div>
        <span class="hidden sm:block text-gray-300">•</span>
        <div class="flex items-center">
          <svg class="w-5 h-5 text-flexio mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          Upisi tokom cijele godine
        </div>
        <span class="hidden sm:block text-gray-300">•</span>
        <div class="flex items-center">
          <svg class="w-5 h-5 text-flexio mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Rezervacija obavezna
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 font-display">
          B.A.S.I. Pilates Zagreb
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Prvi certificirani Pilates studio u Hrvatskoj svjetski poznate američke škole<br class="hidden sm:block" />
          B.A.S.I Pilates (Body Arts & Science International)
        </p>
      </div>

      <!-- Features Section -->
      <div class="mb-16">
        <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8 text-center font-display">
          Zašto odabrati Flexio?
        </h3>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Feature 1 -->
          <div class="bg-white rounded-3xl p-8 text-center shadow-lg hover:shadow-xl transition-shadow">
            <div class="w-16 h-16 bg-gradient-to-br from-flexio to-purple-700 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg relative">
              <div class="absolute inset-0 bg-white/20 rounded-2xl"></div>
              <svg class="w-8 h-8 text-white relative z-10" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-3 text-lg">B.A.S.I. Certificirano</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Suvremeni pristup originalnoj metodi</p>
          </div>

          <!-- Feature 2 -->
          <div class="bg-white rounded-3xl p-8 text-center shadow-lg hover:shadow-xl transition-shadow">
            <div class="w-16 h-16 bg-gradient-to-br from-flexio to-purple-700 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg relative">
              <div class="absolute inset-0 bg-white/20 rounded-2xl"></div>
              <svg class="w-8 h-8 text-white relative z-10" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-3 text-lg">Male grupe</h3>
            <p class="text-sm text-gray-600 leading-relaxed">8-10 osoba za personalizirani pristup</p>
          </div>

          <!-- Feature 3 -->
          <div class="bg-white rounded-3xl p-8 text-center shadow-lg hover:shadow-xl transition-shadow">
            <div class="w-16 h-16 bg-gradient-to-br from-flexio to-purple-700 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg relative">
              <div class="absolute inset-0 bg-white/20 rounded-2xl"></div>
              <svg class="w-8 h-8 text-white relative z-10" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-3 text-lg">Pro oprema</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Reformer, Cadillac, Wunda Chair</p>
          </div>

          <!-- Feature 4 -->
          <div class="bg-white rounded-3xl p-8 text-center shadow-lg hover:shadow-xl transition-shadow">
            <div class="w-16 h-16 bg-gradient-to-br from-flexio to-purple-700 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg relative">
              <div class="absolute inset-0 bg-white/20 rounded-2xl"></div>
              <svg class="w-8 h-8 text-white relative z-10" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 mb-3 text-lg">Fleksibilno</h3>
            <p class="text-sm text-gray-600 leading-relaxed">Upisi tokom cijele godine</p>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a
          href="/o-nama"
          class="inline-block bg-white border-2 border-flexio text-flexio px-8 py-3 rounded-full text-lg font-medium hover:bg-flexio hover:text-white transition-all shadow-md hover:shadow-lg"
        >
          Više o nama
        </a>
      </div>
    </div>
  </section>

  <!-- Programs Section - ZADRŽANO -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-gray-50 to-purple-50/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 font-display">
          Naši programi
        </h2>
        <p class="text-xl text-gray-600">
          Od Pilates mašina do Power Vinyasa Yoga - pronađite program savršen za vas
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 mb-12">
        <!-- Pilates Card -->
        <div class="relative bg-white rounded-3xl p-10 shadow-lg">
          
          <div class="relative">
            <div class="w-16 h-16 bg-gradient-to-br from-purple-600 to-pink-600 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </div>

            <h3 class="text-3xl font-bold text-gray-900 mb-4 font-display">Pilates</h3>
            <p class="text-gray-600 mb-6 text-lg">
              B.A.S.I. Pilates MAT, Power Pilates, Pilates mašine (Reformer, Cadillac, Wunda Chair), Pre & Post Natal, individualni i grupni satovi
            </p>

            <ul class="space-y-3 mb-8">
              <li class="flex items-center text-gray-700">
                <svg class="w-5 h-5 text-purple-600 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Početnici do naprednih
              </li>
              <li class="flex items-center text-gray-700">
                <svg class="w-5 h-5 text-purple-600 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Profesionalna oprema
              </li>
              <li class="flex items-center text-gray-700">
                <svg class="w-5 h-5 text-purple-600 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Mali grupe ili individualno
              </li>
            </ul>

            <a href="/program" class="inline-flex items-center text-purple-600 font-semibold hover:text-purple-700 transition-colors">
              Saznaj više
              <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Yoga Card -->
        <div class="relative bg-white rounded-3xl p-10 shadow-lg">
          
          <div class="relative">
            <div class="w-16 h-16 bg-gradient-to-br from-blue-600 to-cyan-600 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </div>

            <h3 class="text-3xl font-bold text-gray-900 mb-4 font-display">Yoga</h3>
            <p class="text-gray-600 mb-6 text-lg">
              Power Vinyasa Yoga, Ashtanga Mysore, Vinyasa Basic - dinamična yoga prilagođena svim razinama tjelesne pripremljenosti
            </p>

            <ul class="space-y-3 mb-8">
              <li class="flex items-center text-gray-700">
                <svg class="w-5 h-5 text-blue-600 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Svi nivoi dobrodošli
              </li>
              <li class="flex items-center text-gray-700">
                <svg class="w-5 h-5 text-blue-600 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Certificirani instruktori
              </li>
              <li class="flex items-center text-gray-700">
                <svg class="w-5 h-5 text-blue-600 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Jutarnji i večernji termini
              </li>
            </ul>

            <a href="/program" class="inline-flex items-center text-blue-600 font-semibold hover:text-blue-700 transition-colors">
              Saznaj više
              <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a
          href="/program"
          class="inline-block bg-flexio text-white px-8 py-4 rounded-full text-lg font-medium hover:bg-purple-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-1"
        >
          Pogledaj cijeli program
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-purple-50 to-pink-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6 font-display">
        Spremni za početak?
      </h2>
      <p class="text-xl text-gray-600 mb-8">
        Pridružite se našoj zajednici i započnite svoj wellness put danas
      </p>
      <a
        href="/kontakt"
        class="inline-block bg-flexio text-white px-8 py-4 rounded-full text-lg font-medium hover:bg-purple-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-1"
      >
        Kontaktirajte nas
      </a>
    </div>
  </section>
</Layout>
