---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Događanja | Flexio Pilates & Yoga Studio Zagreb"
  description="Radionice, treninzi, workshopovi i specijalni programi u Flexio studiju. Pratite naša događanja."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-purple-50 to-pink-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-bold text-gray-900 mb-6 font-display"
        >
          Događanja
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Radionice, treninzi i specijalni programi za sve razine
        </p>
      </div>
    </div>
  </section>

  <!-- Events Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Event Card 1: Pilates radionica -->
        <div
          class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-3xl p-8 hover:shadow-xl transition-shadow"
        >
          <div
            class="w-16 h-16 bg-flexio rounded-2xl flex items-center justify-center mb-6 shadow-lg"
          >
            <svg
              class="w-8 h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 font-display">
            Pilates radionica
          </h3>
          <p class="text-gray-700 mb-4">
            <!-- Ovdje će biti tvoj sadržaj o radionici -->
          </p>
        </div>

        <!-- Event Card 2: Develop na otoku Rabu -->
        <div
          class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-3xl p-8 hover:shadow-xl transition-shadow"
        >
          <div
            class="w-16 h-16 bg-flexio rounded-2xl flex items-center justify-center mb-6 shadow-lg"
          >
            <svg
              class="w-8 h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 font-display">
            Develop na otoku Rabu
          </h3>
          <p class="text-gray-700 mb-4">
            <!-- Ovdje će biti tvoj sadržaj o programu na Rabu -->
          </p>
        </div>

        <!-- Event Card 3: Prenatal workshop -->
        <div
          class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-3xl p-8 hover:shadow-xl transition-shadow"
        >
          <div
            class="w-16 h-16 bg-flexio rounded-2xl flex items-center justify-center mb-6 shadow-lg"
          >
            <svg
              class="w-8 h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 font-display">
            Prenatal workshop
          </h3>
          <p class="text-gray-700 mb-4">
            <!-- Ovdje će biti tvoj sadržaj o prenatal workshopu -->
          </p>
        </div>

        <!-- Event Card 4: Dan pilatesa -->
        <div
          class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-3xl p-8 hover:shadow-xl transition-shadow"
        >
          <div
            class="w-16 h-16 bg-flexio rounded-2xl flex items-center justify-center mb-6 shadow-lg"
          >
            <svg
              class="w-8 h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 font-display">
            Dan pilatesa
          </h3>
          <p class="text-gray-700 mb-4">
            <!-- Ovdje će biti tvoj sadržaj o danu pilatesa -->
          </p>
        </div>

        <!-- Event Card 5: B.A.S.I. weekend -->
        <div
          class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-3xl p-8 hover:shadow-xl transition-shadow"
        >
          <div
            class="w-16 h-16 bg-flexio rounded-2xl flex items-center justify-center mb-6 shadow-lg"
          >
            <svg
              class="w-8 h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 font-display">
            B.A.S.I. weekend
          </h3>
          <p class="text-gray-700 mb-4">
            <!-- Ovdje će biti tvoj sadržaj o B.A.S.I. vikendu -->
          </p>
        </div>
      </div>

      <!-- Additional Content Section -->
      <div class="mt-16 max-w-4xl mx-auto">
        <div
          class="bg-gradient-to-r from-flexio to-purple-700 rounded-2xl p-8 text-white text-center"
        >
          <h3 class="text-2xl font-bold mb-4">Pratite nas!</h3>
          <p class="text-lg mb-6">
            Sva aktualna događanja i novosti pratite na našoj Facebook stranici
          </p>
          <a
            href="https://www.facebook.com/flexio.hr"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-8 py-3 bg-white text-flexio rounded-full font-semibold hover:bg-gray-100 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path>
            </svg>
            Flexio na Facebooku
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

