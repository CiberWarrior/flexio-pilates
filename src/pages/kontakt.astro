---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Kontakt | Flexio Pilates & Yoga Studio Zagreb"
  description="Kontaktirajte nas za rezervaciju termina. Email: petra@flexio.com.hr, Telefon: 099 2157 495"
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-purple-50 to-pink-50 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-bold text-gray-900 mb-6 font-display"
        >
          Kontakt
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Spremni ste započeti svoj put ka zdravijem tijelu i smirenijem umu?
        <p> Kontaktirajte nas danas! </p>
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Contact Information -->
        <div class="space-y-8">
          <div>
            <h3 class="text-2xl font-semibold text-gray-900 mb-6">
              Informacije
            </h3>
            <div class="space-y-5">
              <!-- Email -->
              <a
                href="mailto:petra@flexio.com.hr"
                class="flex items-start p-4 rounded-xl bg-purple-50 hover:bg-purple-100 transition-colors group"
              >
                <div
                  class="flex-shrink-0 w-12 h-12 bg-flexio rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform"
                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    ></path>
                  </svg>
                </div>
                <div class="ml-4">
                  <p class="text-sm text-gray-500 font-medium">Email</p>
                  <p class="text-lg text-gray-900 font-semibold">
                    petra@flexio.com.hr
                  </p>
                </div>
              </a>

              <!-- Phone -->
              <a
                href="tel:+385992157495"
                class="flex items-start p-4 rounded-xl bg-purple-50 hover:bg-purple-100 transition-colors group"
              >
                <div
                  class="flex-shrink-0 w-12 h-12 bg-flexio rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform"
                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    ></path>
                  </svg>
                </div>
                <div class="ml-4">
                  <p class="text-sm text-gray-500 font-medium">
                    Telefon / Mobitel
                  </p>
                  <p class="text-lg text-gray-900 font-semibold">
                    099 2157 495
                  </p>
                </div>
              </a>

              <!-- Location -->
              <div class="flex items-start p-4 rounded-xl bg-purple-50">
                <div
                  class="flex-shrink-0 w-12 h-12 bg-flexio rounded-lg flex items-center justify-center"
                >
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    ></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </div>
                <div class="ml-4">
                  <p class="text-sm text-gray-500 font-medium">Lokacija</p>
                  <p class="text-lg text-gray-900 font-semibold">
                    Ul. Luke Kaliterne 7
                  </p>
                  <p class="text-base text-gray-600">
                    Jarun, 10000 Zagreb
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Social Media / Facebook -->
          <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl p-6">
            <h4 class="text-lg font-semibold text-gray-900 mb-4">
              Pratite nas
            </h4>
            <p class="text-gray-600 mb-4">
              Sve informacije pratite i na našoj Facebook stranici!
            </p>
            <a
              href="https://www.facebook.com/flexio.pilates"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center px-6 py-3 bg-flexio text-white rounded-full font-medium hover:bg-purple-700 transition-colors"
            >
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                ></path>
              </svg>
              Facebook
            </a>
          </div>

          <!-- Important Info -->
          <div
            class="bg-gradient-to-r from-flexio to-purple-700 rounded-2xl p-6 text-white"
          >
            <h4 class="text-lg font-semibold mb-3">Važno!</h4>
            <p class="text-sm leading-relaxed">
              Termin se ugovara <strong>isključivo putem maila</strong> petra@flexio.com.hr
               ili <strong>mobitela</strong> 099 2157 495. Prije prvog dolaska
              potrebna je rezervacija termina.
            </p>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <div
            class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-3xl p-8 md:p-10"
          >
            <h3 class="text-2xl font-semibold text-gray-900 mb-6">
              Pošaljite poruku
            </h3>
            <form class="space-y-5" id="contact-form">
              <div>
                <label
                  for="name"
                  class="block text-sm font-medium text-gray-700 mb-2"
                  >Vaše ime</label
                >
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-flexio focus:border-transparent transition-all bg-white"
                  placeholder="Ime i prezime"
                />
              </div>
              <div>
                <label
                  for="email"
                  class="block text-sm font-medium text-gray-700 mb-2"
                  >Email adresa</label
                >
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-flexio focus:border-transparent transition-all bg-white"
                  placeholder="vas.email@primjer.com"
                />
              </div>
              <div>
                <label
                  for="phone"
                  class="block text-sm font-medium text-gray-700 mb-2"
                  >Telefon (opcionalno)</label
                >
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-flexio focus:border-transparent transition-all bg-white"
                  placeholder="099 123 4567"
                />
              </div>
              <div>
                <label
                  for="message"
                  class="block text-sm font-medium text-gray-700 mb-2"
                  >Vaša poruka</label
                >
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-flexio focus:border-transparent transition-all bg-white resize-none"
                  placeholder="Recite nam više o tome što vas zanima..."
                ></textarea>
              </div>
              <button
                type="submit"
                class="w-full bg-flexio text-white py-4 rounded-xl font-semibold hover:bg-purple-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
              >
                Pošalji poruku
              </button>
              <p class="text-sm text-gray-600 text-center">
                Odgovorit ćemo vam u najkraćem mogućem roku
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="py-16 bg-gradient-to-br from-gray-50 to-purple-50/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 font-display">
          Pronađite nas
        </h2>
      </div>
      
      <div class="rounded-3xl overflow-hidden shadow-2xl">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2781.4907798066547!2d15.9264!3d45.7972!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4765d1a5c5e5e5e5%3A0x5e5e5e5e5e5e5e5e!2sUlica%20Luke%20Kaliterne%207%2C%2010000%2C%20Zagreb!5e0!3m2!1sen!2shr!4v1234567890"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full"
        ></iframe>
      </div>

      <!-- Directions Link -->
      <div class="text-center mt-8">
        <a
          href="https://www.google.com/maps/dir//Ulica+Luke+Kaliterne+7,+10000,+Zagreb"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center bg-flexio text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-purple-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-1"
        >
          <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
          </svg>
          Prikaži upute za dolazak
        </a>
      </div>
    </div>
  </section>

  <!-- Contact Form Script -->
  <script>
    const contactForm = document.getElementById(
      'contact-form',
    ) as HTMLFormElement | null;
    if (contactForm) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();

        // Get form data
        const formData = new FormData(contactForm);
        const name = formData.get('name');
        const email = formData.get('email');
        const phone = formData.get('phone');
        const message = formData.get('message');

        // Create mailto link
        const subject = encodeURIComponent('Upit sa web stranice - ' + name);
        const body = encodeURIComponent(
          `Ime: ${name}\nEmail: ${email}\nTelefon: ${phone || 'N/A'}\n\nPoruka:\n${message}`,
        );
        const mailtoLink = `mailto:petra@flexio.com.hr?subject=${subject}&body=${body}`;

        // Open email client
        window.location.href = mailtoLink;

        // Show success message
        alert(
          'Vaša poruka će biti otvorena u vašem email klijentu. Molimo pošaljite email kako bismo mogli odgovoriti na vaš upit.',
        );
      });
    }
  </script>
</Layout>

