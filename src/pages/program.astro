---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Program | Flexio Pilates & Yoga Studio Zagreb"
  description="B.A.S.I. Pilates, Power Vinyasa Yoga, Pre & Post Natal, Morning Flow, Big Ball, Rhythm Pilates. Prvi certificirani B.A.S.I. Pilates studio u Hrvatskoj."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-purple-50 via-pink-50 to-purple-100 py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden opacity-10">
      <div class="absolute top-20 left-10 w-72 h-72 bg-flexio rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-purple-600 rounded-full blur-3xl"></div>
    </div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="inline-block mb-6">
          <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-white/80 backdrop-blur-sm text-flexio border border-purple-200 shadow-lg">
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            Prvi certificirani B.A.S.I. Pilates studio u Hrvatskoj
          </span>
        </div>

        <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold text-gray-900 mb-6 font-display leading-tight">
          Naši programi
        </h1>
        <p class="text-xl sm:text-2xl text-gray-700 mb-8 max-w-3xl mx-auto leading-relaxed">
          Pilates i Yoga programi prilagođeni svakoj razini iskustva
        </p>

        <div class="flex flex-wrap justify-center gap-8 mt-12">
          <div class="text-center">
            <div class="text-4xl font-bold text-flexio mb-2">6+</div>
            <div class="text-sm text-gray-600 uppercase tracking-wide">Pilates programa</div>
          </div>
          <div class="h-16 w-px bg-gray-300 hidden sm:block"></div>
          <div class="text-center">
            <div class="text-4xl font-bold text-flexio mb-2">3</div>
            <div class="text-sm text-gray-600 uppercase tracking-wide">Yoga stila</div>
          </div>
          <div class="h-16 w-px bg-gray-300 hidden sm:block"></div>
          <div class="text-center">
            <div class="text-4xl font-bold text-flexio mb-2">17+</div>
            <div class="text-sm text-gray-600 uppercase tracking-wide">Godina iskustva</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-gray-50 to-purple-50/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 font-display">
          Zašto odabrati Flexio?
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Prvi certificirani B.A.S.I. Pilates studio s više od 17 godina iskustva
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        <div class="bg-white rounded-2xl p-6 text-center shadow-md hover:shadow-xl transition-shadow">
          <div class="w-14 h-14 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">B.A.S.I. Certificirano</h3>
          <p class="text-sm text-gray-600">Suvremeni pristup originalnoj metodi</p>
        </div>

        <div class="bg-white rounded-2xl p-6 text-center shadow-md hover:shadow-xl transition-shadow">
          <div class="w-14 h-14 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Male grupe</h3>
          <p class="text-sm text-gray-600">8-10 osoba za personalizirani pristup</p>
        </div>

        <div class="bg-white rounded-2xl p-6 text-center shadow-md hover:shadow-xl transition-shadow">
          <div class="w-14 h-14 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Pro oprema</h3>
          <p class="text-sm text-gray-600">Reformer, Cadillac, Wunda Chair</p>
        </div>

        <div class="bg-white rounded-2xl p-6 text-center shadow-md hover:shadow-xl transition-shadow">
          <div class="w-14 h-14 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Fleksibilno</h3>
          <p class="text-sm text-gray-600">Upisi tokom cijele godine</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Programs Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-purple-50/30 via-white to-pink-50/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Pilates Programs -->
      <div class="relative mb-20">
        <!-- Background decoration for Pilates -->
        <div class="absolute inset-0 bg-gradient-to-br from-purple-100/20 via-transparent to-purple-50/20 rounded-3xl -mx-4 -my-8 blur-3xl"></div>
        
        <div class="relative">
          <div class="text-center mb-12">
            <div class="inline-block mb-4">
              <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold bg-gradient-to-r from-purple-600 to-pink-600 text-white shadow-lg">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
                Pilates
              </span>
            </div>
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 font-display">
              Pilates programi
            </h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
              Od početnika do naprednih, od rehabilitacije do power treninga
            </p>
          </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          <!-- B.A.S.I. Pilates MAT -->
          <div class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-2xl transition-all duration-300 border-2 border-transparent hover:border-flexio">
            <div class="w-12 h-12 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 font-display">B.A.S.I. Pilates MAT</h3>
            <p class="text-sm text-gray-600 mb-3">Početni, srednji i napredni stupanj vježbanja na podlozi</p>
            <div class="flex flex-wrap gap-1">
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Početnici</span>
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Napredni</span>
            </div>
          </div>

          <!-- Power Pilates -->
          <div class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-2xl transition-all duration-300 border-2 border-transparent hover:border-flexio">
            <div class="w-12 h-12 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 font-display">Power Pilates</h3>
            <p class="text-sm text-gray-600 mb-3">Napredni, dinamični Pilates za iskusnije vježbače</p>
            <div class="flex flex-wrap gap-1">
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Napredni</span>
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Intenzivno</span>
            </div>
          </div>

          <!-- Rhythm Pilates -->
          <div class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-2xl transition-all duration-300 border-2 border-transparent hover:border-flexio">
            <div class="w-12 h-12 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 font-display">Rhythm Pilates</h3>
            <p class="text-sm text-gray-600 mb-3">Pilates vježbe uz plesnu koreografiju i muziku</p>
            <div class="flex flex-wrap gap-1">
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Ples</span>
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Fun</span>
            </div>
          </div>

          <!-- Big Ball -->
          <div class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-2xl transition-all duration-300 border-2 border-transparent hover:border-flexio">
            <div class="w-12 h-12 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 font-display">Big Ball</h3>
            <p class="text-sm text-gray-600 mb-3">Pilates vježbe na lopti za ravnotežu i stabilnost</p>
            <div class="flex flex-wrap gap-1">
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Ravnoteža</span>
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Stabilnost</span>
            </div>
          </div>

          <!-- Pilates Mašine -->
          <div class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-2xl transition-all duration-300 border-2 border-transparent hover:border-flexio">
            <div class="w-12 h-12 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 font-display">Pilates mašine</h3>
            <p class="text-sm text-gray-600 mb-3">Reformer, Wunda Chair, Ladder Barrel, Spine Corrector</p>
            <div class="flex flex-wrap gap-1">
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Individualno</span>
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Oprema</span>
            </div>
          </div>

          <!-- Pre & Post Natal -->
          <div class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-2xl transition-all duration-300 border-2 border-transparent hover:border-flexio">
            <div class="w-12 h-12 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 font-display">Pre & Post Natal</h3>
            <p class="text-sm text-gray-600 mb-3">Za trudnice i žene koje se oporavljaju nakon poroda</p>
            <div class="flex flex-wrap gap-1">
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Trudnoća</span>
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Oporavak</span>
            </div>
          </div>

          <!-- Morning Flow -->
          <div class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-2xl transition-all duration-300 border-2 border-transparent hover:border-flexio">
            <div class="w-12 h-12 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 font-display">Morning Flow</h3>
            <p class="text-sm text-gray-600 mb-3">Jutarnji pilates za energiju i dobar početak dana</p>
            <div class="flex flex-wrap gap-1">
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Jutro</span>
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Energija</span>
            </div>
          </div>
        </div>
        </div>
      </div>

      <!-- Yoga Programs -->
      <div class="relative mb-16">
        <!-- Background decoration for Yoga -->
        <div class="absolute inset-0 bg-gradient-to-br from-pink-100/20 via-transparent to-purple-50/20 rounded-3xl -mx-4 -my-8 blur-3xl"></div>
        
        <div class="relative">
          <div class="text-center mb-12">
            <div class="inline-block mb-4">
              <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold bg-gradient-to-r from-pink-600 to-purple-600 text-white shadow-lg">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
                Yoga
              </span>
            </div>
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4 font-display">
              Yoga programi
            </h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
              Različiti stilovi yoge za sve razine pripremljenosti
            </p>
          </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          <!-- Power Vinyasa Yoga -->
          <div class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-2xl transition-all duration-300 border-2 border-transparent hover:border-flexio">
            <div class="w-12 h-12 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 font-display">Power Vinyasa Yoga</h3>
            <p class="text-sm text-gray-600 mb-3">Intenzivan, dinamičan stil yoge za snagu i energiju</p>
            <div class="flex flex-wrap gap-1">
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Intenzivno</span>
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Dinamično</span>
            </div>
          </div>

          <!-- Ashtanga Mysore -->
          <div class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-2xl transition-all duration-300 border-2 border-transparent hover:border-flexio">
            <div class="w-12 h-12 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 font-display">Ashtanga Mysore</h3>
            <p class="text-sm text-gray-600 mb-3">Tradicionalna jutarnja praksa sa individualnim pristupom</p>
            <div class="flex flex-wrap gap-1">
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Jutro</span>
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Personalizirano</span>
            </div>
          </div>

          <!-- Vinyasa Basic -->
          <div class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-2xl transition-all duration-300 border-2 border-transparent hover:border-flexio">
            <div class="w-12 h-12 bg-gradient-to-br from-flexio to-purple-700 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2 font-display">Vinyasa Basic</h3>
            <p class="text-sm text-gray-600 mb-3">Opuštajuća atmosfera, idealno za početnike i napredne</p>
            <div class="flex flex-wrap gap-1">
              <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-full text-xs">Slow Flow</span>
